// 4.4.FORTY DIGITAL BIBLE — relational data model
// Postgres. Taxonomy values (statuses, roles, relationship types) are strings
// validated at the app layer (src/lib/taxonomy.ts) so vocabulary can evolve
// without migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Used by Prisma CLI (migrations). With a pooled provider like Neon this
  // should be the direct/unpooled connection string; locally it's just the
  // same value as DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String   @default("VIEWER") // VIEWER | EDITOR | ADMIN
  passwordHash String
  createdAt    DateTime @default(now())

  favorites    Favorite[]
  recentViews  RecentView[]
  savedViews   SavedView[]
  collections  Collection[]
  auditLogs    AuditLog[]
  aiThreads    AiThread[]
  ingestItems  IngestItem[]
  ownedFormats Format[]            @relation("FormatOwner")
  ownedOpps    Opportunity[]       @relation("OpportunityOwner")
}

// ---------------------------------------------------------------------------
// Primary objects
// ---------------------------------------------------------------------------

model Creator {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  aliases          String[]  @default([])
  imageUrl         String?
  headline         String?
  status           String    @default("active") // active | watch | archived
  miniBio          String?
  digitalSummary   String?
  opportunityNotes String?
  internalNotes    String?
  birthday         DateTime?
  age              Int? // used when only an approximate age is known
  lastVerifiedAt   DateTime?
  archived         Boolean   @default(false)
  archivedReason String?
  archivedAt     DateTime?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  socialProfiles SocialProfile[]
  entityLinks    CreatorEntityLink[]
  credits        CreatorProjectCredit[]
  organizations  CreatorOrganization[]
  people         CreatorPerson[]
  formats        CreatorFormat[]
  relationshipsA CreatorRelationship[]  @relation("RelA")
  relationshipsB CreatorRelationship[]  @relation("RelB")
  opportunities  OpportunityCreator[]

  @@index([name])
  @@index([updatedAt])
}

model SocialProfile {
  id             String    @id @default(cuid())
  creatorId      String
  platform       String // instagram | tiktok | youtube | x | twitch | ...
  handle         String?
  url            String?
  followerCount  Int?
  engagementRate Float? // percent, e.g. 4.47 — the headline metric in creator tooling
  countUpdatedAt DateTime?
  notes          String?

  creator   Creator          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  snapshots SocialSnapshot[]

  @@index([creatorId])
  @@index([platform])
}

model SocialSnapshot {
  id              String   @id @default(cuid())
  socialProfileId String
  followerCount   Int
  recordedAt      DateTime @default(now())

  socialProfile SocialProfile @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)

  @@index([socialProfileId])
}

model Project {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  aliases        String[]  @default([])
  imageUrl       String?
  projectType    String? // tv_series | documentary | podcast | ...
  status         String    @default("released") // released | airing | in_production | ended | announced
  logline        String?
  description    String?
  premiereYear   Int?
  endYear        Int?
  seasons        Int?
  episodes       Int?
  runtimeMinutes Int?
  country        String?
  trailerUrl     String?
  officialUrl    String?
  imdbUrl        String?
  youtubeUrl     String?
  internalNotes  String?
  lastVerifiedAt DateTime?
  archived       Boolean   @default(false)
  archivedReason String?
  archivedAt     DateTime?
  version        Int       @default(1)
  lastActivityAt DateTime? // real-world date this last moved, from the source material
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  credits       CreatorProjectCredit[]
  organizations ProjectOrganization[]
  entityLinks   ProjectEntityLink[]
  people        PersonProject[]
  opportunities OpportunityProject[]

  @@index([title])
  @@index([projectType])
}

model Organization {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  aliases       String[] @default([])
  types         String[] @default([]) // production_company | brand | network | ...
  imageUrl      String?
  description   String?
  website       String?
  location      String?
  internalNotes String?
  archived      Boolean  @default(false)
  archivedReason String?
  archivedAt     DateTime?
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects      ProjectOrganization[]
  creators      CreatorOrganization[]
  people        PersonOrganization[]
  opportunities OpportunityOrganization[]
  formats       FormatOrganization[]

  @@index([name])
}

model IndustryPerson {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  title     String?
  roleType  String? // agent | manager | publicist | executive | producer | ...
  email     String?
  phone     String?
  contactUrl String? // LinkedIn / website / booking page
  assistantName  String?
  assistantEmail String?
  notes     String?
  archived  Boolean  @default(false)
  archivedReason String?
  archivedAt     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations PersonOrganization[]
  creators      CreatorPerson[]
  projects      PersonProject[]

  @@index([name])
}

model Format {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  logline          String?
  description      String?
  formatType       String? // competition | docuseries | podcast | ...
  status           String   @default("idea")
  targetPlatform   String?
  episodeStructure String?
  episodeLength    String?
  productionScale  String?
  location         String?
  sponsorFit       String?
  notes            String?
  ownerId          String?
  archived         Boolean  @default(false)
  archivedReason String?
  archivedAt     DateTime?
  version          Int      @default(1)
  lastActivityAt DateTime? // real-world date this last moved, from the source material
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  owner         User?                @relation("FormatOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  creators      CreatorFormat[]
  entityLinks   FormatEntityLink[]
  organizations FormatOrganization[]
  opportunities OpportunityFormat[]

  @@index([title])
  @@index([status])
}

model Opportunity {
  id                   String    @id @default(cuid())
  slug                 String    @unique
  title                String
  type                 String? // brand_brief | casting_need | ...
  status               String    @default("researching")
  description          String?
  audienceRequirements String?
  platformRequirements String?
  outcome              String?
  notes                String?
  deadline             DateTime?
  ownerId              String?
  archived             Boolean   @default(false)
  archivedReason String?
  archivedAt     DateTime?
  version              Int       @default(1)
  lastActivityAt DateTime? // real-world date this last moved, from the source material
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  owner         User?                     @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  creators      OpportunityCreator[]
  formats       OpportunityFormat[]
  projects      OpportunityProject[]
  organizations OpportunityOrganization[]
  entityLinks   OpportunityEntityLink[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Taxonomy — reusable canonical entities
// ---------------------------------------------------------------------------

model Entity {
  id          String   @id @default(cuid())
  kind        String // interest | hobby | sport | location | genre | creator_category | skill | vertical | audience_type | tag
  slug        String
  name        String
  aliases     String[] @default([])
  description String?
  createdAt   DateTime @default(now())

  creatorLinks     CreatorEntityLink[]
  formatLinks      FormatEntityLink[]
  projectLinks     ProjectEntityLink[]
  opportunityLinks OpportunityEntityLink[]
  sportsEvents     SportsEvent[]

  @@unique([kind, slug])
  @@index([name])
  @@index([kind])
}

model CreatorEntityLink {
  id           String  @id @default(cuid())
  creatorId    String
  entityId     String
  relationship String  @default("") // for locations: based_in | hometown | born_in | works_in
  confidence   String? // confirmed | reported | internal | unverified
  note         String?

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  entity  Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([creatorId, entityId, relationship])
  @@index([entityId])
}

model FormatEntityLink {
  id       String @id @default(cuid())
  formatId String
  entityId String

  format Format @relation(fields: [formatId], references: [id], onDelete: Cascade)
  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([formatId, entityId])
  @@index([entityId])
}

model ProjectEntityLink {
  id        String @id @default(cuid())
  projectId String
  entityId  String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entity  Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([projectId, entityId])
  @@index([entityId])
}

model OpportunityEntityLink {
  id            String @id @default(cuid())
  opportunityId String
  entityId      String

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  entity      Entity      @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, entityId])
  @@index([entityId])
}

// ---------------------------------------------------------------------------
// Relationships between primary objects (all carry metadata)
// ---------------------------------------------------------------------------

model CreatorProjectCredit {
  id         String  @id @default(cuid())
  creatorId  String
  projectId  String
  role       String // host | executive_producer | cast | ...
  note       String?
  confidence String?

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([creatorId, projectId, role])
  @@index([projectId])
  @@index([role])
}

model ProjectOrganization {
  id             String  @id @default(cuid())
  projectId      String
  organizationId String
  relationship   String // production_company | network | distributor | ...
  note           String?

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([projectId, organizationId, relationship])
  @@index([organizationId])
}

model CreatorOrganization {
  id             String  @id @default(cuid())
  creatorId      String
  organizationId String
  relationship   String // brand_partner | founder | investor | ambassador | ...
  status         String? // active | past
  startYear      Int?
  endYear        Int?
  note           String?
  confidence     String?

  creator      Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([creatorId, organizationId, relationship])
  @@index([organizationId])
}

model CreatorPerson {
  id           String  @id @default(cuid())
  creatorId    String
  personId     String
  relationship String // agent | manager | publicist | attorney | other
  current      Boolean @default(true)
  start        String? // free text: "2023", "May 2024"
  end          String?
  note         String?
  confidence   String?

  creator Creator        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  person  IndustryPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([creatorId, personId, relationship])
  @@index([personId])
}

model PersonOrganization {
  id             String  @id @default(cuid())
  personId       String
  organizationId String
  role           String?
  current        Boolean @default(true)

  person       IndustryPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([personId, organizationId])
  @@index([organizationId])
}

model PersonProject {
  id        String  @id @default(cuid())
  personId  String
  projectId String
  role      String // director | showrunner | executive_producer | ...
  note      String?

  person  IndustryPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([personId, projectId, role])
  @@index([projectId])
}

model CreatorFormat {
  id        String  @id @default(cuid())
  creatorId String
  formatId  String
  isPrimary Boolean @default(false)
  note      String?

  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  format  Format  @relation(fields: [formatId], references: [id], onDelete: Cascade)

  @@unique([creatorId, formatId])
  @@index([formatId])
}

model FormatOrganization {
  id             String  @id @default(cuid())
  formatId       String
  organizationId String
  relationship   String  @default("associated") // sponsor_target | partner | ...
  note           String?

  format       Format       @relation(fields: [formatId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([formatId, organizationId, relationship])
  @@index([organizationId])
}

// Symmetric creator-to-creator connection. Stored once with creatorAId < creatorBId
// (enforced at the app layer); queries always check both directions.
model CreatorRelationship {
  id           String  @id @default(cuid())
  creatorAId   String
  creatorBId   String
  relationship String // collaborated_with | co_host | business_partner | ...
  note         String?
  confidence   String?

  creatorA Creator @relation("RelA", fields: [creatorAId], references: [id], onDelete: Cascade)
  creatorB Creator @relation("RelB", fields: [creatorBId], references: [id], onDelete: Cascade)

  @@unique([creatorAId, creatorBId, relationship])
  @@index([creatorBId])
}

model OpportunityCreator {
  id            String  @id @default(cuid())
  opportunityId String
  creatorId     String
  status        String  @default("candidate") // candidate | shortlist | contacted | passed
  note          String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  creator     Creator     @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, creatorId])
  @@index([creatorId])
}

model OpportunityFormat {
  id            String  @id @default(cuid())
  opportunityId String
  formatId      String
  note          String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  format      Format      @relation(fields: [formatId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, formatId])
  @@index([formatId])
}

model OpportunityProject {
  id            String  @id @default(cuid())
  opportunityId String
  projectId     String
  note          String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, projectId])
  @@index([projectId])
}

model OpportunityOrganization {
  id             String  @id @default(cuid())
  opportunityId  String
  organizationId String
  note           String?

  opportunity  Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, organizationId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Collections, saved views, favorites, recents
// ---------------------------------------------------------------------------

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User?            @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  items CollectionItem[]
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  targetType   String // creator | format | project | organization
  targetId     String
  note         String?
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, targetType, targetId])
  @@index([targetType, targetId])
}

model SavedView {
  id         String   @id @default(cuid())
  name       String
  ownerId    String
  targetType String // creators | projects | formats | ...
  query      String // URL querystring encoding filters/sort
  createdAt  DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

model RecentView {
  id         String   @id @default(cuid())
  userId     String
  targetType String
  targetId   String
  viewedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId, viewedAt])
}

// ---------------------------------------------------------------------------
// Provenance, attachments, audit
// ---------------------------------------------------------------------------

model Source {
  id          String    @id @default(cuid())
  title       String?
  url         String?
  sourceType  String? // public | representative | internal | social | official | research
  publication String?
  publishedAt DateTime?
  notes       String?
  addedById   String?
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  records RecordSource[]
}

model RecordSource {
  id         String  @id @default(cuid())
  sourceId   String
  targetType String
  targetId   String
  note       String?

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetType, targetId])
  @@index([targetType, targetId])
}

model Attachment {
  id         String @id @default(cuid())
  targetType String
  targetId   String
  filename   String
  /// Blob pathname when storage is "blob"; StoredFile key when storage is "db".
  storedPath String
  /// Where the bytes actually live: "blob" (Vercel Blob) or "db" (Postgres).
  /// Files stopped living in the database once real media arrived — a rough
  /// cut is gigabytes, and Postgres is the wrong place for it.
  storage      String   @default("db")
  /// The blob's own URL. Kept for deletes and for `head` checks; never handed
  /// to a browser, since private blobs are reached through a signed redirect.
  blobUrl      String?
  mimeType     String?
  sizeBytes    Int?
  /// Video and audio only, when the browser could read it before uploading.
  durationSeconds Int?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([targetType, targetId])
}

// Uploaded file contents. Serverless filesystems are ephemeral, so bytes live
// in Postgres with everything else — attachments survive deploys and appear
// in backups. `key` is the opaque name used in /api/files/<key> URLs.
model StoredFile {
  id        String   @id @default(cuid())
  key       String   @unique
  mimeType  String?
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String? // denormalized for display
  targetType  String
  targetId    String
  targetLabel String // denormalized display name
  action      String // created | updated | linked | unlinked | archived | restored | merged
  field       String?
  oldValue    String?
  newValue    String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// AI & research inbox
// ---------------------------------------------------------------------------

model AiThread {
  id        String   @id @default(cuid())
  userId    String?
  title     String?
  createdAt DateTime @default(now())

  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages AiMessage[]
}

model AiMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      String // user | assistant
  content   String
  results   Json? // structured result cards
  createdAt DateTime @default(now())

  thread AiThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
}

// Compact, always-current, AI-readable index of every canonical record.
// One row per record; `summary` reads like a dossier card, `searchText` packs
// every name/alias/handle/related-name for candidate matching. The migration
// adds (raw SQL): a generated tsvector column over searchText with a GIN
// index, plus pg_trgm trigram indexes on name and searchText.
model KnowledgeDigest {
  id            String   @id @default(cuid())
  targetType    String // creator | project | organization | format | person | opportunity | entity | event
  targetId      String
  slug          String
  name          String
  aliases       String[] @default([])
  archived      Boolean  @default(false)
  summary       String
  searchText    String
  // Generated column (see the knowledge_digest migration); queried via $queryRaw.
  searchVector  Unsupported("tsvector")?
  sourceVersion Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([targetType, targetId])
  @@index([name])
  @@index([searchVector], type: Gin, map: "KnowledgeDigest_searchVector_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "KnowledgeDigest_name_trgm_idx")
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "KnowledgeDigest_searchText_trgm_idx")
}

// Upcoming sports calendar: US professional and major world sports events.
// Curated + fully editable; optionally linked to a sport taxonomy entity so
// events connect into the knowledge graph.
model SportsEvent {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  league      String? // NFL, NBA, FIFA, F1, ...
  sportId     String?
  startDate   DateTime
  endDate     DateTime?
  location    String?
  notes       String?
  approximate Boolean   @default(false) // dates not yet officially fixed
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sport Entity? @relation(fields: [sportId], references: [id], onDelete: SetNull)

  @@index([startDate])
}

// Full-database snapshot: every table serialized to JSON. Written by the
// daily cron and the admin "Back Up Now" button; downloadable for offline
// safekeeping; restorable with scripts/restore-backup.mjs.
model Snapshot {
  id        String   @id @default(cuid())
  kind      String   @default("manual") // manual | scheduled
  label     String?
  counts    Json // { creators: 20, users: 3, ... } summary for display
  data      Json // the complete dump
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// One row per ingested source: an uploaded file, pasted text, or a child
// unpacked from a zip/mbox/email attachments. Raw bytes retained in Postgres
// up to a configurable cap; extracted text always retained.
model IngestItem {
  id            String   @id @default(cuid())
  kind          String // email | document | text | archive
  filename      String?
  mimeType      String?
  sizeBytes     Int?
  raw           Bytes?
  rawRetained   Boolean  @default(false)
  extractedText String?
  context       String? // optional uploader note: what this is and why it matters
  webResearch   Boolean  @default(false) // allow web search to fill gaps during propose
  metadata      Json?
  parentId      String?
  threadId      String?
  status        String   @default("uploaded") // uploaded | parsed | triaged | irrelevant | proposed | applied | failed
  relevance     Json?
  tokenUsage    Json?
  error         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parent    IngestItem?    @relation("IngestChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  IngestItem[]   @relation("IngestChildren")
  createdBy User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  changes   IngestChange[]

  @@index([status])
  @@index([threadId])
  @@index([createdAt])
}

// One row per proposed change awaiting review. `payload` holds the validated
// op the apply engine consumes; `evidence` holds verbatim source snippets
// with character offsets into extractedText.
model IngestChange {
  id          String    @id @default(cuid())
  itemId      String
  group       String // review-UI grouping label, e.g. "Talent › Maya Delgado"
  destination Json // { targetType, targetId|null, field|linkKind, path }
  opType      String // create | update | link | unlink | archive | note
  payload     Json
  before      Json?
  after       Json
  confidence  Float     @default(0.5)
  rationale   String?
  evidence    Json?
  sensitive   Boolean   @default(false)
  status      String    @default("pending") // pending | approved | edited | rejected | applied | failed | superseded
  editedAfter Json?
  appliedAt   DateTime?
  appliedById String?
  error       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  item IngestItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, status])
}

/// A long-form document that lives in the Repo and is edited in place — the
/// development slate above all. The slate was a Google Doc everyone linked to
/// and nobody could see from inside the Repo; this is that document, next to
/// the records it describes.
model Doc {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  /// Sanitized HTML. Written only by editors, and stripped of anything active
  /// on the way in — see sanitizeDocHtml.
  content       String   @default("")
  /// Optimistic concurrency: two people typing must not silently overwrite
  /// one another, and an autosaving editor makes that likelier, not rarer.
  version       Int      @default(1)
  updatedById   String?
  updatedByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  revisions DocRevision[]
}

/// The document as it stood before a save that replaced a lot of it. Autosave
/// means there is no moment where someone consciously decides to keep a copy,
/// so the app has to decide for them.
model DocRevision {
  id            String   @id @default(cuid())
  docId         String
  content       String
  /// Why this version was kept: "before importing slate.pdf", "restored", …
  note          String?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId, createdAt])
}
